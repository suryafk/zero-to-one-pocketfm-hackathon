# --- OpenAI (required) ---
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_VIDEO_MODEL=sora-2
# Explicitly enable only during a controlled demo; video renders consume credits.
VIDEO_GENERATION_ENABLED=false

# --- TTS layer (optional, defaults to "mock" so the API runs without it) ---
TTS_PROVIDER=openai
STT_PROVIDER=openai
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- App ---
CORS_ALLOW_ORIGINS=*
